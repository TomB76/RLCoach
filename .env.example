# ---------------------------------------------------------------------------
# RL Coach — configuration (copie ce fichier en .env, ou saisis tout dans l'UI)
# ---------------------------------------------------------------------------

# Port du serveur web local
PORT=4317

# --- API Stats locale de Rocket League -------------------------------------
# Activée dans le jeu : Documents\My Games\Rocket League\TAGame\Config\TAStatsAPI.ini
#   [TAGame.MatchStatsExporter_TA]
#   Port=49123
#   PacketSendRate=30
# Le jeu expose un WebSocket ET un socket TCP brut sur ce port.
RL_STATS_HOST=127.0.0.1
RL_STATS_PORT=49123
# Mode de connexion : "ws" (WebSocket) ou "tcp"
RL_STATS_TRANSPORT=ws
# Démarre la connexion automatiquement au lancement du serveur
RL_AUTO_CONNECT=true

# --- Ballchasing.com -------------------------------------------------------
# Token gratuit : https://ballchasing.com/upload -> "API token" (compte requis)
BALLCHASING_TOKEN=
# Cohorte pro : nombre de replays pro analysés par mode
PRO_COHORT_SIZE=120
# Throttle API ballchasing (ms entre deux requêtes, la doc conseille ~2 req/s)
BALLCHASING_MIN_INTERVAL_MS=550

# --- Divers ----------------------------------------------------------------
# Lance un match de démonstration simulé au démarrage (sans le jeu)
DEMO_ON_START=false

# --- Coach IA (optionnel) --------------------------------------------------
# Aucun appel réseau sans configuration explicite. API compatible OpenAI.
# AI_PROVIDER=none | openai | ollama | custom
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# true = génère le débriefing IA automatiquement à la fin de chaque match
AI_AUTO=false
